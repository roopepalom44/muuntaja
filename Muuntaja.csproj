<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<NoWarn>CA1416</NoWarn>
		<!-- QGIS-lisäosa ja sen DWG-kirjoitin (oma .NET-projekti) eivät kuulu Add-Iniin. -->
		<DefaultItemExcludes>$(DefaultItemExcludes);qgis_plugin\**</DefaultItemExcludes>
	</PropertyGroup>
	<ItemGroup>
		<None Remove="Config.daml" />
		<None Remove="Images\muuntaja16.png" />
		<None Remove="Images\muuntaja32.png" />
		<None Remove="Toolboxes\Muuntaja.pyt" />
		<None Remove="Toolboxes\cad_worker.py" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Config.daml" />
		<Content Include="Images\AddInDesktop16.png" />
		<Content Include="Images\AddInDesktop32.png" />
		<Content Include="DarkImages\AddInDesktop16.png" />
		<Content Include="DarkImages\AddInDesktop32.png" />
		<Content Include="Images\muuntaja16.png" />
		<Content Include="Images\muuntaja32.png" />
		<Content Include="Toolboxes\Muuntaja.pyt">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="Toolboxes\cad_worker.py">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup>
		<None Include="Properties\launchSettings.json" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Esri.ArcGISPro.Extensions30" Version="3.5.0.57366" />
	</ItemGroup>
  <ItemGroup>
    <Content Include="SharedHelp\index.html"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="SharedHelp\manifest.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="SharedHelp\Icons\*.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="SharedHelp\TypeCheck\**\*.cs" />
  </ItemGroup>
</Project>
